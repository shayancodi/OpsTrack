# Copy values into backend/.env for local development (do not commit .env)

# Backend
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/opstrack
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
NODE_ENV=development

# Frontend (Vite) — put these in frontend/.env later
VITE_API_URL=http://localhost:3000
